# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PAYSTACK_PUBLIC_KEY: Your Paystack public key (pk_live_... or pk_test_...).
# Get this from your Paystack Dashboard > Settings > API Keys & Webhooks.
PAYSTACK_PUBLIC_KEY="pk_test_sample_paystack_key"

# WHATSAPP_CHANNEL_URL: Your official WhatsApp Channel or VIP Group link.
# Format: https://whatsapp.com/channel/... or https://chat.whatsapp.com/...
WHATSAPP_CHANNEL_URL="https://whatsapp.com/channel/apexmatch-vip-intel"

# ADMIN_PIN: Secret owner passcode to access settings and transaction logs.
# Default is 8821. You can customize this or change it inside the Settings modal.
ADMIN_PIN="8821"
